SERVICE_NAME=identity-service
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://identity_service:replace-with-identity-password@localhost:5432/identity_db
JWT_ISSUER=cinema-booking-identity
JWT_AUDIENCE=cinema-booking-api
JWT_KEY_ID=identity-dev-key-1
JWT_PRIVATE_KEY_PATH=dev-keys/private.pem
JWT_PUBLIC_KEY_PATH=dev-keys/public.pem
EMAIL_LINK_BASE_URL=http://localhost:3007
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

