SERVICE_NAME=ticket-service
PORT=3005
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://ticket_service:replace-with-ticket-password@localhost:5432/ticket_db
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ticket-service
KAFKA_GROUP_ID=ticket-service
TICKET_QR_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Managed Kafka only
# KAFKA_SSL=true
# KAFKA_SASL_MECHANISM=scram-sha-256
# KAFKA_USERNAME=replace-with-kafka-username
# KAFKA_PASSWORD=replace-with-kafka-password
# KAFKA_CA_CERT_PATH=/etc/secrets/kafka-ca.pem


