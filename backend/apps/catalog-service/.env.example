SERVICE_NAME=catalog-service
PORT=3002
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://catalog_service:replace-with-catalog-password@localhost:5432/catalog_db
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=catalog-service
# Managed Kafka only
# KAFKA_SSL=true
# KAFKA_SASL_MECHANISM=scram-sha-256
# KAFKA_USERNAME=replace-with-kafka-username
# KAFKA_PASSWORD=replace-with-kafka-password
# KAFKA_CA_CERT_PATH=/etc/secrets/kafka-ca.pem

