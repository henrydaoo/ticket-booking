SERVICE_NAME=notification-service
PORT=3006
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://notification_service:replace-with-notification-password@localhost:5432/notification_db
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=notification-service
KAFKA_GROUP_ID=notification-service-foundation
# Managed Kafka only
# KAFKA_SSL=true
# KAFKA_SASL_MECHANISM=scram-sha-256
# KAFKA_USERNAME=replace-with-kafka-username
# KAFKA_PASSWORD=replace-with-kafka-password
# KAFKA_CA_CERT_PATH=/etc/secrets/kafka-ca.pem
EMAIL_PROVIDER_BASE_URL=https://deferred-provider.example
EMAIL_PROVIDER_API_KEY=deferred-to-local-secret

